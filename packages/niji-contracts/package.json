{
  "name": "@niji/contracts",
  "version": "0.3.0",
  "description": "Nouns solidity contracts & artifacts",
  "homepage": "https://nouns.wtf",
  "license": "GPL-3.0",
  "author": "Nounders",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist/**",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm build:sol && pnpm build:ts",
    "build:sol": "hardhat compile",
    "build:ts": "tsup",
    "clean": "rimraf dist .openzeppelin artifacts cache foundry-cache foundry-out typechain",
    "coverage": "hardhat coverage",
    "dev": "pnpm task:run-local",
    "dev:local": "cp .env.local .env && pnpm task:run-local",
    "dev:dev": "cp .env.dev .env && hardhat --network base-sepolia deploy-niji-base-sepolia",
    "dev:prod": "cp .env.prod .env && echo 'production deploy は verify-niji + manual confirm 必須'",
    "hardhat": "hardhat",
    "task:accounts": "hardhat accounts",
    "task:deploy": "hardhat deploy",
    "task:deploy-and-configure": "hardhat deploy-and-configure",
    "task:mint-noun": "hardhat mint-noun",
    "task:populate-descriptor": "hardhat populate-descriptor",
    "task:run-local": "hardhat run-local-dao-v3",
    "test": "hardhat test"
  },
  "dependencies": {
    "ds-test": "dapphub/ds-test",
    "ethers": "^6.14.0",
    "forge-std": "foundry-rs/forge-std#v1.7.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.4.0",
    "@openzeppelin/contracts-v5": "npm:@openzeppelin/contracts@5.4.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^5.2.2",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/prompt": "^1.1.0",
    "base64-sol": "^1.0.1",
    "chai": "^4.5.0",
    "dotenv": "catalog:",
    "hardhat": "2.28.6",
    "hardhat-abi-exporter": "^2.9.0",
    "hardhat-gas-reporter": "^1.0.8",
    "mocha": "^11.7.0",
    "pngjs": "^7.0.0",
    "prettier-plugin-solidity": "^2.0.0",
    "prompt": "^1.1.0",
    "shx": "^0.4.0",
    "solidity-coverage": "0.8.16",
    "terser": "^5.43.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typechain": "^8.3.2"
  }
}
