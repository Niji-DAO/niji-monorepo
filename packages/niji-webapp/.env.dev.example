# niji-webapp .env.dev (base sepolia chainId 84532)
# 使い方 = cp .env.dev.example .env.dev
#
# 重要 = env 名は src/config.ts が実際に読む名前に統一 (旧 VITE_RPC_URL / VITE_SUBGRAPH_URL は
# config.ts では未使用だった drift、 2026-07-21 修正)。

VITE_CHAIN_ID=84532

# chain RPC (config.ts app[baseSepolia].jsonRpcUri が読む)
VITE_BASE_SEPOLIA_JSONRPC=https://sepolia.base.org
VITE_BASE_SEPOLIA_WSRPC=

# subgraph (config.ts app[baseSepolia].subgraphApiUri が読む)、 明日 Goldsky deploy 後に URL 反映
VITE_BASE_SEPOLIA_SUBGRAPH=

# subgraph 障害時の chain fallback scan 起点 (auction proxy deploy block、 2026-07-21 deploy)
VITE_BASE_SEPOLIA_DEPLOY_BLOCK=44424079

# 過去 auction 履歴 UI on/off
VITE_ENABLE_HISTORY=true

# niji-api (Cloudflare Workers) の base URL、 Workers deploy 後の *.workers.dev を反映
VITE_NIJI_API_BASE_URL=
VITE_SPOT_RATE_URL=

# 以下 2 key = .env.local から手動 copy (dev 用 test key、 共通で OK)
VITE_WALLET_CONNECT_V2_PROJECT_ID=
VITE_FINCODE_PUBLIC_KEY=
