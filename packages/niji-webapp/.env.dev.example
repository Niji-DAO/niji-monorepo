# niji-webapp .env.dev (base sepolia chainId 84532)
# 使い方 = cp .env.dev.example .env.dev
#
# 重要 = env 名は src/config.ts が実際に読む名前に統一。
# 旧 VITE_RPC_URL / VITE_SUBGRAPH_URL も config.ts の fallback で受けるが新名を推奨 (2026-07-21)。

VITE_CHAIN_ID=84532

# chain RPC (config.ts app[baseSepolia].jsonRpcUri が読む)
VITE_BASE_SEPOLIA_JSONRPC=https://sepolia.base.org
VITE_BASE_SEPOLIA_WSRPC=

# subgraph (config.ts app[baseSepolia].subgraphApiUri が読む)、 Goldsky deploy 後に URL 反映
VITE_BASE_SEPOLIA_SUBGRAPH=

# subgraph 障害時の chain fallback scan 起点 (auction proxy deploy block、 2026-07-21 deploy)
VITE_BASE_SEPOLIA_DEPLOY_BLOCK=44424079

# 過去 auction 履歴 UI on/off
VITE_ENABLE_HISTORY=true

# niji-api (Cloudflare Workers) の base URL (2026-07-21 deploy 済)
VITE_NIJI_API_BASE_URL=https://niji-api.niji-app.workers.dev
VITE_SPOT_RATE_URL=

# niji-data-rle.json (29MB) の hosting URL。 Cloudflare Pages は 25 MiB/file 上限のため
# R2 に置いて webapp は起動時 fetch (nijiAssets.ts)。 deploy:pages script が dist から niji-data を除外。
VITE_NIJI_DATA_URL=https://pub-67d52b8a2566480e927c6b527731815c.r2.dev/niji-data-rle.json

# 以下 2 key = .env.local から手動 copy (dev 用 test key、 共通で OK)
VITE_WALLET_CONNECT_V2_PROJECT_ID=
VITE_FINCODE_PUBLIC_KEY=

# ============================================================================
# Basic 認証 (Cloudflare Pages 限定公開、 public/_worker.js が読む)
# 注意 = これらは VITE_ prefix なし = webapp bundle には入らず、 Cloudflare Pages の
# 環境変数 / secret として設定する (wrangler pages secret put or dashboard)。
# .env.dev に書いた値は「Pages secret に流す source」 であって webapp build には使わない。
# 未設定なら _worker.js は認証 skip (fail-open)。
# ============================================================================
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
