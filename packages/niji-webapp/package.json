{
  "name": "@niji/webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm copy-niji-data",
    "build": "tsc -b && vite build",
    "build:base-sepolia": "tsc -b && vite build --mode base-sepolia",
    "check": "tsc --noEmit --skipLibCheck",
    "clean": "rimraf dist .netlify",
    "copy-niji-data": "mkdir -p public && cp ../niji-assets/src/niji-data-rle.json public/niji-data-rle.json",
    "predev": "pnpm copy-niji-data",
    "dev": "VITE_CHAIN_ID=31337 NODE_OPTIONS='--max-old-space-size=1536' vite",
    "dev:base-sepolia": "vite --mode base-sepolia",
    "graphql-codegen": "graphql-codegen-esm --config codegen.config.ts",
    "graphql-codegen:watch": "graphql-codegen-esm --config codegen.config.ts --watch",
    "i18n:ai-translate": "pnpm dlx lingo.dev i18n",
    "i18n:compile": "lingui compile",
    "i18n:extract": "lingui extract",
    "i18n:pseudo": "lingui extract --locale pseudo && lingui compile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:e2e": "playwright test"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lingui/core": "^5.9.0",
    "@lingui/detect-locale": "^5.9.0",
    "@lingui/loader": "^5.9.0",
    "@lingui/macro": "^5.9.0",
    "@lingui/react": "^5.9.0",
    "@niji/assets": "workspace:*",
    "@niji/contracts": "workspace:*",
    "@niji/sdk": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-virtual": "^3.13.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@wagmi/core": "catalog:",
    "bad-words": "^3.0.4",
    "blo": "^2.0.0",
    "bootstrap": "^5.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.1",
    "dayjs": "^1.10.7",
    "graphql": "^16.11.0",
    "jotai": "^2.12.5",
    "jotai-effect": "^2.0.4",
    "jotai-tanstack-query": "^0.9.0",
    "jszip": "^3.10.1",
    "lucide-react": "catalog:",
    "motion": "^12.16.0",
    "next-themes": "^0.4.6",
    "pngjs": "^6.0.0",
    "react": "catalog:",
    "react-bootstrap": "^2.10.10",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "catalog:",
    "react-markdown": "^9.1.0",
    "react-number-format": "^5.4.4",
    "react-router": "^7.6.2",
    "react-router-dom": "^7.6.0",
    "remark-breaks": "^4.0.0",
    "remeda": "^2.22.3",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "viem": "catalog:",
    "wagmi": "catalog:"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.12.16",
    "@graphql-codegen/cli": "^5.0.6",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@graphql-codegen/typed-document-node": "^5.1.1",
    "@graphql-codegen/typescript-document-nodes": "^4.0.16",
    "@graphql-codegen/typescript-operations": "^4.6.0",
    "@kiwa-test/core": "^0.1.0",
    "@lingui/babel-plugin-lingui-macro": "^5.9.0",
    "@lingui/cli": "^5.9.0",
    "@lingui/vite-plugin": "^5.9.0",
    "@parcel/watcher": "^2.5.1",
    "@playwright/test": "1.54.1",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/bad-words": "^3.0.1",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "catalog:",
    "globals": "^16.1.0",
    "graphql-scalars": "^1.24.2",
    "is-ci": "^4.1.0",
    "jsdom": "^26.1.0",
    "msw": "^2.14.0",
    "playwright": "^1.53.1",
    "postcss": "^8.5.3",
    "process": "^0.11.10",
    "tailwindcss": "^3.4.17",
    "terser": "^5.43.1",
    "typescript-eslint": "^8.56.1",
    "viem": "^2",
    "vite": "^7.0.0",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-inspect": "^11.3.0",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.0"
  }
}
