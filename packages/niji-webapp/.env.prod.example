# niji-webapp .env.prod (production mainnet)
# 使い方 = cp .env.prod.example .env.prod

VITE_CHAIN_ID=1
VITE_RPC_URL=
VITE_SUBGRAPH_URL=

# fiat 入札と spot rate 表示の共通 base URL。
# spot rate は GET {base}/api/v1/spot-rate/eth-jpy を polling する。
VITE_NIJI_API_BASE_URL=https://api.niji-dao.example

# spot rate の endpoint override (任意)。 未設定なら上の VITE_NIJI_API_BASE_URL を使う。
VITE_GMO_API_ENDPOINT_SPOT_RATE=

VITE_WALLET_CONNECT_V2_PROJECT_ID=
VITE_FINCODE_PUBLIC_KEY=
